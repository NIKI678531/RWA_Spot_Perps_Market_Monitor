# Copy to backend/.env and fill in. Never commit the real .env.

# --- Core ---
ENVIRONMENT=local
DATABASE_URL=sqlite:///./app.db
API_BASE_PATH=/
FRONTEND_ORIGINS=http://localhost:3025,http://localhost:8085

# --- Data sources ---
# CoinGecko: free tier is ~30 req/min. A Pro/Analyst key lifts the full-universe
# refresh from hourly to 15-minutely. Leave blank to run on the public endpoint.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# GeckoTerminal: public, no key required.
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# Loris: public pages expose only the top 25 venues and no contract history.
# A key is required for full cross-venue perp coverage.
LORIS_API_KEY=
LORIS_BASE_URL=https://loris.tools

# Binance: public market-data endpoints need no key.
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FAPI_BASE_URL=https://fapi.binance.com

# Alpaca: IEX feed, used only as a directional underlying reference during US
# market hours. Not SIP-consolidated — never treat the basis as an arbitrage signal.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://data.alpaca.markets

# --- Report delivery ---
# No PVC in production K8s: generated xlsx/docx go to object storage or the DB.
REPORT_STORAGE_BACKEND=database
TOS_ENDPOINT=
TOS_BUCKET=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

# --- Scheduling (HKT) ---
DAILY_REPORT_CRON=0 8 * * *
