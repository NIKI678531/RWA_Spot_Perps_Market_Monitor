# Copy to backend/.env and fill in. Never commit the real .env.
#
# Every value here is optional: each field has a working default in
# app/core/config.py, and every collector degrades to NOT_VERIFIED rather than
# failing when its credential is absent. Nothing below is required to boot.

# --- Core ---
ENVIRONMENT=local
DATABASE_URL=sqlite:///./app.db
API_BASE_PATH=/
FRONTEND_ORIGINS=http://localhost:3025,http://localhost:8085

# --- Scheduling (HKT) ---
# Off by default: a dev machine running collectors against live rate limits is the
# worse failure, and a throttled source costs the production instance too. Turn it
# on locally when you want the dashboard to keep refreshing rather than showing one
# frozen snapshot. Cadences are in services/scheduler.py.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Hong_Kong
DAILY_REPORT_CRON=0 8 * * *

# --- Free, no key required ---------------------------------------------------
# GeckoTerminal, Hyperliquid and Binance market data are public endpoints.
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FAPI_BASE_URL=https://fapi.binance.com

# Cross-venue perpetuals. Public market-data endpoints, no key. Together these
# reconstruct the cross-venue perp aggregation that the source workbook took from
# the Loris public page, which is capped at a Top 25 with no history.
OKX_BASE_URL=https://www.okx.com
BYBIT_BASE_URL=https://api.bybit.com
GATE_BASE_URL=https://api.gateio.ws
MEXC_FUTURES_BASE_URL=https://contract.mexc.com
BITGET_BASE_URL=https://api.bitget.com

# Issuer catalogues. These are the coverage denominator: an issuer's own product
# count exceeds any aggregator's index, so "indexed / official" is only meaningful
# against the issuer's number.
ONDO_PRODUCTS_URL=https://ondo.finance/ondo-stocks
XSTOCKS_PRODUCTS_URL=https://xstocks.com/products
XSTOCKS_ECOSYSTEM_URL=https://xstocks.com/ecosystem

# --- Optional keys -----------------------------------------------------------
# CoinGecko: the free tier is ~30 req/min, which the hourly cadence stays inside.
# A Pro/Analyst key lifts the full-universe refresh from hourly to 15-minutely.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Alpaca: supplies the TradFi reference price behind the token-vs-share basis on
# the overview and the reference-coverage figure on the data-quality page. Without
# these two values that block renders an explanation instead of an empty table.
# The free tier is IEX, a single venue carrying a few per cent of US equity volume
# — directional only. Never read the basis as an arbitrage signal.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://data.alpaca.markets
ALPACA_FEED=iex

# Loris: the free XHR endpoint is tried first and needs no key. A key widens
# coverage beyond the public page's Top 25 and unlocks contract history. Absent
# both, the five CEX perp collectors above cover the same ground.
LORIS_API_KEY=
LORIS_BASE_URL=https://loris.tools
LORIS_API_BASE_URL=https://api.loris.tools

# --- Report delivery ---
# No PVC in production K8s: generated xlsx/docx go to object storage or the DB.
REPORT_STORAGE_BACKEND=database
TOS_ENDPOINT=
TOS_BUCKET=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
